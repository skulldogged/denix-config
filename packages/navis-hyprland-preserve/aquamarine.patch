+bool Aquamarine::CWaylandBackend::replaceRenderNodeForLab(int fd) {
+    if (!getenv("HYPRLAND_MIGRATION_LAB") || drmGetNodeTypeFromFd(fd) != DRM_NODE_RENDER)
+        return false;
+    const int replacement = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+    if (replacement < 0) return false;
+    char* name = drmGetRenderDeviceNameFromFd(replacement);
+    if (!name) { close(replacement); return false; }
+    if (drmState.fd >= 0) close(drmState.fd);
+    drmState.fd = replacement;
+    drmState.nodeName = name;
+    free(name);
+    return true;
+}
