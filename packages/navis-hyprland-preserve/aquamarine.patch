+std::string Aquamarine::CBackend::parkDRMForMigration() {
+    if (!getenv("HYPRLAND_MIGRATION_PHYSICAL") || !session || !session->active)
+        return "physical migration requires an active opt-in seat session";
+    if (migration.parked) return "DRM backends are already parked";
+    std::vector<SP<CDRMBackend>> devices;
+    std::vector<std::string> paths;
+    for (const auto& impl : implementations) {
+        if (impl->type() != AQ_BACKEND_DRM) continue;
+        auto drm = static_cast<CDRMBackend*>(impl.get())->self.lock();
+        for (const auto& conn : drm->connectors)
+            if (conn->output && conn->output->lease) return "a DRM lease prevents parking";
+        std::error_code error;
+        auto path = std::filesystem::canonical(std::filesystem::path("/sys/class/drm") /
+            std::filesystem::path(drm->gpu->path).filename() / "device", error);
+        if (error) return "cannot retain a stable sysfs GPU identity";
+        paths.push_back(path.string());
+        devices.push_back(drm);
+    }
+    if (devices.empty()) return "no physical DRM backends to park";
+    CFileDescriptor render{fcntl(drmRenderNodeFD(), F_DUPFD_CLOEXEC, 0)};
+    if (!render.isValid()) return "cannot retain the renderer descriptor during KMS retirement";
+
+    // All checks above precede output changes. Disconnect while KMS descriptors
+    // are valid, drain worker submissions, then synchronously disable scanout.
+    bool reset = true;
+    for (const auto& drm : devices) {
+        drm->stopCommitThread();
+        for (const auto& conn : drm->connectors) conn->disconnect();
+        drm->stopCommitThread();
+        reset = drm->impl->reset() && reset;
+    }
+    if (!reset) {
+        for (const auto& drm : devices) {
+            if (drm->atomic) drm->initCommitThread();
+            drm->recheckOutputs();
+        }
+        events.pollFDsChanged.emit();
+        return "KMS reset failed; physical outputs were re-offered";
+    }
+    migration.parked = true;
+    migration.renderFD = std::move(render);
+    migration.sysfsDevices = std::move(paths);
+    std::erase_if(implementations, [](const auto& impl) { return impl->type() == AQ_BACKEND_DRM; });
+    // Remove fd callbacks before their objects/descriptors can be destroyed.
+    events.pollFDsChanged.emit();
+    for (const auto& drm : devices) {
+        drm->listeners = {};
+        std::erase(session->sessionDevices, drm->gpu);
+    }
+    devices.clear();
+    return {};
+}
+
+std::string Aquamarine::CBackend::resumeDRMForMigration() {
+    if (!getenv("HYPRLAND_MIGRATION_PHYSICAL") || !session || !session->active || !migration.parked)
+        return "physical resume requires an active parked seat session";
+    if (std::ranges::any_of(implementations, [](const auto& b) { return b->type() == AQ_BACKEND_DRM; }))
+        return "unexpected DRM backend while parked";
+    std::vector<std::string> paths;
+    // Resolve fresh card numbers from stable device identities after rebind.
+    for (const auto& device : migration.sysfsDevices) {
+        std::error_code error;
+        std::string card;
+        for (const auto& entry : std::filesystem::directory_iterator(device + "/drm", error)) {
+            const auto name = entry.path().filename().string();
+            if (name.starts_with("card") && name.find('-') == std::string::npos) {
+                if (!card.empty()) return "multiple DRM cards for one saved GPU";
+                card = "/dev/dri/" + name;
+            }
+        }
+        if (error || card.empty()) return "a saved GPU has no DRM card yet";
+        paths.push_back(card);
+    }
+    std::vector<SP<CDRMBackend>> restored;
+    for (const auto& path : paths) {
+        auto drm = CDRMBackend::fromGpu(path, self.lock(), restored.empty() ? nullptr : restored.front());
+        if (!drm || !drm->start()) {
+            if (drm) std::erase(session->sessionDevices, drm->gpu);
+            for (const auto& old : restored) std::erase(session->sessionDevices, old->gpu);
+            return "could not reopen all saved DRM backends; staying headless";
+        }
+        restored.push_back(drm);
+    }
+    for (const auto& drm : restored) implementations.push_back(drm);
+    events.pollFDsChanged.emit();
+    for (const auto& drm : restored) drm->onReady();
+    for (const auto& drm : restored) drm->recheckOutputs();
+    migration.parked = false;
+    // Keep renderFD until the next park/destruction: compositor protocols may
+    // borrow it until their caller replaces those references after this method.
+    migration.sysfsDevices.clear();
+    return {};
 }
 
