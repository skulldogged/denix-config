+bool Aquamarine::CBackend::replaceRenderNodeForLab(int fd) {
+    if (!getenv("HYPRLAND_MIGRATION_LAB")) return false;
+    if (migration.parked) {
+        if (drmGetNodeTypeFromFd(fd) != DRM_NODE_RENDER) return false;
+        CFileDescriptor replacement{fcntl(fd, F_DUPFD_CLOEXEC, 0)};
+        if (!replacement.isValid()) return false;
+        migration.renderFD = std::move(replacement);
+        return true;
+    }
+    if (hasSession()) return false;
+    CWaylandBackend* wayland = nullptr;
+    for (const auto& impl : implementations) {
+        if (impl->type() == AQ_BACKEND_DRM) return false;
+        if (impl->type() == AQ_BACKEND_WAYLAND) {
+            if (wayland) return false;
+            wayland = static_cast<CWaylandBackend*>(impl.get());
+        }
+    }
+    return wayland && wayland->replaceRenderNodeForLab(fd);
 }
 
