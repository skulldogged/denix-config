+                    checkGL("texture readback failed; original renderer kept");
+                }
+            }
+            copies.emplace_back(std::move(copy));
+        }
+    } catch (...) {
+        g_pHyprOpenGL->bindFramebuffer(GL_FRAMEBUFFER, 0);
+        glDeleteFramebuffers(1, &scratch);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        throw;
+    }
+    g_pHyprOpenGL->bindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDeleteFramebuffers(1, &scratch);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+
+    std::map<Aquamarine::IOutput*, Aquamarine::SSwapchainOptions> outputOptions;
+    if (unload) {
+        // This path is restricted to the disposable SHM-client lab. Once the
+        // driver is unloaded, a reconstruction failure ends that lab only.
+        g_pHyprRenderer->m_renderData.currentFB.reset();
+        g_pHyprRenderer->m_renderData.mainFB.reset();
+        g_pHyprRenderer->m_renderData.outFB.reset();
+        g_pHyprRenderer->m_renderbuffers.clear();
+        g_pHyprRenderer->m_currentBuffer.reset();
+        for (const auto& mon : State::monitorState()->monitors()) {
+            auto output = mon->m_output;
+            outputOptions[output.get()] = output->swapchain->currentOptions();
+            output->state->setBuffer(nullptr);
+            output->setCursor(nullptr, {});
+            output->swapchain.reset();
+        }
+        // GBM destructors contain driver function pointers too. Retire every
+        // old output buffer and allocator before unloading their code.
+        g_pCompositor->m_aqBackend->primaryAllocator.reset();
+        labAllocators.clear();
+        for (auto* shader : activeShaders) shader->destroy();
+        for (auto* fb : activeFBs) {
+            glDeleteFramebuffers(1, &fb->m_fb);
+            fb->m_fb = 0;
+            fb->m_fbAllocated = false;
+        }
+        for (auto& copy : copies) {
+            glDeleteTextures(1, &copy.original->m_texID);
+            copy.original->m_texID = 0;
+            copy.original->m_cachedStates.fill(std::nullopt);
+        }
+        g_pHyprOpenGL->releaseContext();
+        if (!unloadEGL()) std::terminate();
+        // Loading both vendors can itself reopen NVIDIA. During an Intel park,
+        // load Mesa alone; a later release-to-NVIDIA unloads and selects NVIDIA.
+        const auto device = std::filesystem::canonical(std::filesystem::path("/sys/class/drm") / resolved.filename() / "device/driver").filename().string();
+        setenv("__EGL_VENDOR_LIBRARY_FILENAMES", device == "nvidia" ?
+            "/run/opengl-driver/share/glvnd/egl_vendor.d/10_nvidia.json:/run/opengl-driver/share/glvnd/egl_vendor.d/50_mesa.json" :
+            "/run/opengl-driver/share/glvnd/egl_vendor.d/50_mesa.json", 1);
