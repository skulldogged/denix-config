+        g_pHyprOpenGL.reset();
+        g_pHyprOpenGL = std::move(candidate);
+    }
+    g_pHyprOpenGL->makeEGLCurrent();
+    g_pHyprOpenGL->bindFramebuffer(GL_FRAMEBUFFER, 0);
+    ++generation;
+    for (auto& mon : State::monitorState()->monitors()) g_pHyprRenderer->damageMonitor(mon);
