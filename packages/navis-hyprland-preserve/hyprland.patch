+            if (fb->m_stencilTex) glClearBufferfi(GL_DEPTH_STENCIL, 0, 1.F, 0);
+            fbCopies.emplace_back(fb, std::move(replacement));
+        }
+        if (replaceOutputs) {
+            auto& allocator = labAllocators[resolved.string()];
+            if (!allocator) {
+                require(labAllocators.size() <= 8, "laboratory allocator limit reached");
+                const int fd = fcntl(g_pHyprOpenGL->m_drmFD, F_DUPFD_CLOEXEC, 0);
+                require(fd >= 0, "could not duplicate allocator render-node descriptor");
+                allocator = Aquamarine::CGBMAllocator::create(fd, g_pCompositor->m_aqBackend);
+                if (!allocator) close(fd);
+                require(bool(allocator), "could not create target output allocator");
+            }
+            for (const auto& mon : State::monitorState()->monitors()) {
+                auto output = mon->m_output;
+                auto chain = Aquamarine::CSwapchain::create(allocator, output->getBackend());
+                const auto options = unload ? outputOptions.at(output.get()) : output->swapchain->currentOptions();
+                require(options.length > 0 && chain->reconfigure(options), "could not allocate target output buffers");
+                outputCopies.emplace_back(output, chain);
+                for (size_t i = 0; i < options.length; ++i) {
+                    auto buffer = chain->next(nullptr);
+                    require(bool(buffer), "target swapchain has no buffer");
+                    auto rb = makeShared<CGLRenderbuffer>(buffer, buffer->dmabuf().format);
+                    require(rb->good(), "target cannot render into its new output buffer");
+                    newOutputRBs.emplace_back(rb);
+                }
+            }
+            if (!unload) for (auto* rb : originalRenderbuffers) {
+                auto buffer = rb->m_hlBuffer.lock();
+                require(std::ranges::any_of(outputCopies, [&](const auto& entry) { return entry.first->swapchain->contains(buffer); }),
+                    "a renderbuffer is not owned by a nested output swapchain");
+            }
+        } else for (auto* rb : originalRenderbuffers) {
+            auto buffer = rb->m_hlBuffer.lock();
+            require(bool(buffer), "output buffer expired during migration");
+            auto replacement = std::make_unique<CGLRenderbuffer>(buffer, buffer->dmabuf().format);
+            require(replacement->good(), "target cannot import an existing output buffer; original renderer kept");
+            rbCopies.emplace_back(rb, std::move(replacement));
+        }
+        glFinish();
+        checkGL("candidate resource validation failed");
+        if (!commit) throw std::runtime_error("PROBE_PASS: candidate renderer and resources validated; original renderer retained");
+    } catch (const std::exception& e) {
+        const std::string reason = e.what();
+        if (unload) {
+            LOG(Log::ERR, "Driver-release reconstruction failed: {}", reason);
+            std::terminate();
+        }
+        for (size_t i = 0; i < swappedTextures; ++i) swapTexture(copies[i]);
+        // Candidate objects now contain candidate handles again. Delete them in their own context.
+        clearCopies();
+        g_pHyprOpenGL.reset();
+        g_pHyprOpenGL = std::move(original);
+        g_pHyprOpenGL->makeEGLCurrent();
+        for (auto& mon : State::monitorState()->monitors()) g_pHyprRenderer->damageMonitor(mon);
+        return reason.starts_with("PROBE_PASS") ? reason : "error: " + reason;
+    }
+
+    for (auto& [a, b] : shaderCopies) swapShader(a, b.get());
+    for (auto& [a, b] : fbCopies) swapFB(a, b.get());
+    for (auto& [a, b] : rbCopies) swapRB(a, b.get());
