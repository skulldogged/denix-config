+#pragma once
+
+#include <string>
+
+class CShader;
+namespace Render::GL {
+    class CGLTexture;
+    class CGLFramebuffer;
+    class CGLRenderbuffer;
+
+    // Deliberately opt-in laboratory. No DRM device removal or VFIO operations.
+    class CMigration {
+      public:
+        static std::string command(const std::string& request);
+        static void track(CGLTexture*);
+        static void track(CGLFramebuffer*);
+        static void track(CGLRenderbuffer*);
+        static void track(CShader*);
+        static void untrack(CGLTexture*);
+        static void untrack(CGLFramebuffer*);
+        static void untrack(CGLRenderbuffer*);
+        static void untrack(CShader*);
