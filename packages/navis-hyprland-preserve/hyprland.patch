+    // Preserve CPU-side shader/cache objects referenced by the renderer and the desktop.
+    g_pHyprOpenGL->m_shaders = std::move(original->m_shaders);
+    g_pHyprOpenGL->m_shadersInitialized = original->m_shadersInitialized;
+    g_pHyprOpenGL->m_finalScreenShader = std::move(original->m_finalScreenShader);
+    g_pHyprOpenGL->m_monitorBGFBs = std::move(original->m_monitorBGFBs);
+    g_pHyprOpenGL->m_pressedHistoryPositions = original->m_pressedHistoryPositions;
+    g_pHyprOpenGL->m_pressedHistoryTimers = original->m_pressedHistoryTimers;
+    g_pHyprOpenGL->m_pressedHistoryKilled = original->m_pressedHistoryKilled;
+    g_pHyprOpenGL->m_pressedHistoryTouched = original->m_pressedHistoryTouched;
+    g_pHyprRenderer->m_renderData.currentFB.reset();
+    g_pHyprRenderer->m_renderData.mainFB.reset();
+    g_pHyprRenderer->m_renderData.outFB.reset();
+
+    if (!unload) {
+        candidate = std::move(g_pHyprOpenGL);
+        g_pHyprOpenGL = std::move(original);
+        g_pHyprOpenGL->makeEGLCurrent();
+    }
+    if (replaceOutputs) {
+        // Destroy old GL imports with the old context before retiring their buffers.
+        g_pHyprRenderer->m_renderbuffers.clear();
+        g_pHyprRenderer->m_currentBuffer.reset();
+        for (auto& [output, chain] : outputCopies) std::swap(output->swapchain, chain);
+        g_pHyprRenderer->m_renderbuffers = std::move(newOutputRBs);
+    }
+    clearCopies(); // These handles belong to the old context after the swaps.
+    if (unload) {
+        original.reset();
+        auto allocator = labAllocators.at(resolved.string());
+        if (!g_pCompositor->m_aqBackend->replaceRenderNodeForLab(g_pHyprOpenGL->m_drmFD)) std::terminate();
+        g_pCompositor->m_aqBackend->primaryAllocator = allocator;
+        updateProtocolNodes();
+        g_pHyprOpenGL->makeEGLCurrent();
+        if (PROTO::linuxDma && !PROTO::linuxDma->migrateRenderNodeForLab(g_pHyprOpenGL->m_drmFD)) std::terminate();
+        if (PROTO::mesaDRM && !PROTO::mesaDRM->migrateRenderNodeForLab(resolved.string())) std::terminate();
