     m_formatTable = std::move(newFormatTable);
 }
 
+size_t CLinuxDMABufV1Protocol::preferDeviceForLab(int fd, const std::vector<SDRMFormat>& formats) {
+    if (!getenv("HYPRLAND_MIGRATION_LAB") || g_pCompositor->m_aqBackend->hasSession())
+        throw std::runtime_error("GPU preference experiment requires the nested laboratory");
+    const auto dev = devIDFromFD(fd);
+    if (!dev || formats.empty()) throw std::runtime_error("invalid preference device/formats");
+    auto table = makeUnique<CDMABUFFormatTable>(SDMABUFTranche{.device = *dev, .flags = 0, .formats = formats},
+        std::vector<std::pair<PHLMONITORREF, SDMABUFTranche>>{});
+    if (!table->m_tableFD.isValid() || !table->m_tableSize)
+        throw std::runtime_error("could not build preference format table");
+    // Existing imports and the actual rendering device remain intact. Announce
+    // the intended target first, observing whether clients voluntarily migrate.
+    m_mainDevice = *dev;
+    m_formatTable = std::move(table);
+    for (const auto& feedback : m_feedbacks) {
+        feedback->m_resource->sendFormatTable(m_formatTable->m_tableFD.get(), m_formatTable->m_tableSize);
+        feedback->sendDefaultFeedback();
+    }
+    return m_feedbacks.size();
+}
+
+bool CLinuxDMABufV1Protocol::migrateRenderNodeForLab(int fd) {
+    if (!getenv("HYPRLAND_MIGRATION_LAB") || !migrationIdle()) return false;
+    auto dev = devIDFromFD(fd);
+    CFileDescriptor next{fcntl(fd, F_DUPFD_CLOEXEC, 0)};
+    if (!dev || !next.isValid()) return false;
+    auto table = makeUnique<CDMABUFFormatTable>(SDMABUFTranche{.device = *dev, .flags = 0, .formats = g_pHyprRenderer->getDRMFormats()},
+        std::vector<std::pair<PHLMONITORREF, SDMABUFTranche>>{});
+    if (!table->m_tableFD.isValid()) return false;
+    m_mainDevice = *dev;
+    m_mainDeviceFD = std::move(next);
+    m_formatTable = std::move(table);
+    return true;
+}
+
 void CLinuxDMABufV1Protocol::bindManager(wl_client* client, void* data, uint32_t ver, uint32_t id) {
     const auto& RESOURCE = m_managers.emplace_back(makeUnique<CLinuxDMABUFResource>(makeUnique<CZwpLinuxDmabufV1>(client, ver, id)));
 
