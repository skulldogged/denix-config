+    // Only the non-unload path retains a live original context for rollback.
+    UP<CHyprOpenGLImpl> candidate;
+    try { candidate = makeUnique<CHyprOpenGLImpl>(target.get()); }
+    catch (...) { if (unload) std::terminate(); throw; }
+    candidate->m_migrationFD = std::move(target);
+    auto original = std::move(g_pHyprOpenGL);
+    g_pHyprOpenGL = std::move(candidate);
+    g_pHyprOpenGL->makeEGLCurrent();
+    if (g_pCompositor->m_aqBackend->drmParkedForMigration())
+        g_pCompositor->m_aqBackend->setMigrationRenderFormats(g_pHyprOpenGL->getDRMFormats());
+    std::vector<std::pair<CShader*, std::unique_ptr<CShader>>> shaderCopies;
+    std::vector<std::pair<CGLFramebuffer*, std::unique_ptr<CGLFramebuffer>>> fbCopies;
+    std::vector<std::pair<CGLRenderbuffer*, std::unique_ptr<CGLRenderbuffer>>> rbCopies;
+    std::vector<std::pair<SP<Aquamarine::IOutput>, SP<Aquamarine::CSwapchain>>> outputCopies;
+    std::vector<SP<IRenderbuffer>> newOutputRBs;
+    size_t swappedTextures = 0;
+
+    auto swapTexture = [](TextureCopy& copy) {
+        std::swap(copy.original->m_texID, copy.replacement->m_texID);
+        std::swap(copy.original->m_cachedStates, copy.replacement->m_cachedStates);
+    };
+    auto swapShader = [](CShader* a, CShader* b) {
+        std::swap(a->m_program, b->m_program);
+        std::swap(a->m_uniformLocations, b->m_uniformLocations);
+        std::swap(a->uniformStatus, b->uniformStatus);
+    };
+    auto swapFB = [](CGLFramebuffer* a, CGLFramebuffer* b) {
+        std::swap(a->m_fb, b->m_fb);
+        std::swap(a->m_fbAllocated, b->m_fbAllocated);
+    };
+    auto swapRB = [](CGLRenderbuffer* a, CGLRenderbuffer* b) {
+        std::swap(a->m_rbo, b->m_rbo);
+        std::swap(a->m_image, b->m_image);
+        std::swap(a->m_framebuffer, b->m_framebuffer);
+    };
+    auto clearCopies = [&] {
+        newOutputRBs.clear();
+        outputCopies.clear();
+        rbCopies.clear();
+        fbCopies.clear();
+        shaderCopies.clear();
+        copies.clear();
+    };
+
+    try {
+        for (auto& copy : copies) {
+            copy.replacement = std::make_unique<CGLTexture>();
+            auto& tex = *copy.replacement;
+            tex.allocate(copy.original->m_size, copy.original->m_drmFormat);
+            tex.bind();
+            if (copy.width && copy.height) {
+                if (copy.depth)
+                    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, copy.width, copy.height, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+                else
+                    glTexImage2D(GL_TEXTURE_2D, 0, copy.internal, copy.width, copy.height, 0,
+                        GL_RGBA, copy.floating ? GL_FLOAT : GL_UNSIGNED_BYTE,
+                        copy.floating ? static_cast<void*>(copy.floats.data()) : static_cast<void*>(copy.bytes.data()));
+            }
+            for (size_t i = 0; i < std::size(parameters); ++i) tex.setTexParameter(parameters[i], copy.params[i]);
+            checkGL("candidate texture upload failed");
+            swapTexture(copy);
+            ++swappedTextures;
+        }
+        for (auto* shader : activeShaders) {
+            auto replacement = std::make_unique<CShader>();
+            require(replacement->createProgram(shader->m_migrationVert, shader->m_migrationFrag, true, true), "candidate shader compilation failed");
+            shaderCopies.emplace_back(shader, std::move(replacement));
+        }
+        for (auto* fb : activeFBs) {
+            require(bool(fb->m_tex), "framebuffer has no color texture");
+            auto replacement = std::make_unique<CGLFramebuffer>();
+            glGenFramebuffers(1, &replacement->m_fb);
+            replacement->m_fbAllocated = true;
+            g_pHyprOpenGL->bindFramebuffer(GL_FRAMEBUFFER, replacement->m_fb);
+            glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, fb->m_tex->m_texID, 0);
+            if (fb->m_mirrorTex) glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, fb->m_mirrorTex->m_texID, 0);
+            const GLenum buffers[] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+            glDrawBuffers(fb->m_mirrorTex ? 2 : 1, buffers);
+            if (fb->m_stencilTex) glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, fb->m_stencilTex->m_texID, 0);
