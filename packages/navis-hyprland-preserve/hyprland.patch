+#include "Migration.hpp"
+#include "OpenGL.hpp"
+#include "Renderer.hpp"
+#include "gl/GLTexture.hpp"
+#include "gl/GLFramebuffer.hpp"
+#include "gl/GLRenderbuffer.hpp"
+#include "../Compositor.hpp"
+#include "../state/MonitorState.hpp"
+#include <xf86drm.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <set>
+#include <sstream>
+#include <memory>
+#include <stdexcept>
+#include <cstdlib>
+#include <filesystem>
+#include <aquamarine/allocator/GBM.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include "../protocols/LinuxDMABUF.hpp"
+#include "../protocols/MesaDRM.hpp"
+#include "../protocols/DRMSyncobj.hpp"
+#include "../protocols/DRMLease.hpp"
+#include "../xwayland/XWayland.hpp"
+#include <dlfcn.h>
+
+using namespace Render;
+using namespace Render::GL;
+using Hyprutils::OS::CFileDescriptor;
+
+namespace {
+    std::set<CGLTexture*> textures;
+    std::set<CGLFramebuffer*> framebuffers;
+    std::set<CGLRenderbuffer*> renderbuffers;
+    std::set<CShader*> shaders;
+    bool busy = false;
+    unsigned generation = 0;
+    std::string lastResult = "not attempted";
+    // Ordinary switches cache allocators; the release experiment retires them.
+    std::map<std::string, SP<Aquamarine::IAllocator>> labAllocators;
+
+    bool physicalEnabled() {
+        const char* value = getenv("HYPRLAND_MIGRATION_PHYSICAL");
+        return value && std::string(value) == "1";
+    }
+
+    std::string clientBlocker() {
+        if (PROTO::sync && !PROTO::sync->migrationIdle()) return "explicit-sync clients are still connected";
+        if (PROTO::linuxDma && !PROTO::linuxDma->migrationIdle()) return "DMA-BUF clients are still connected";
+        if (PROTO::mesaDRM && !PROTO::mesaDRM->migrationIdle()) return "legacy DRM clients are still connected";
+        for (const auto& [_, lease] : PROTO::lease)
+            if (!lease->migrationIdle()) return "DRM lease clients are still connected";
+        for (auto* tex : textures)
+            if (tex->isDMA()) return "imported client buffers remain (including fading windows)";
+        return {};
+    }
+
+    void updateProtocolNodes() {
+        g_pCompositor->m_drm.fd = g_pCompositor->m_aqBackend->drmFD();
+        g_pCompositor->m_drmRenderNode.fd = g_pCompositor->m_aqBackend->drmRenderNodeFD();
+        auto supported = [](int fd) {
+            uint64_t cap = 0;
+            return fd >= 0 && drmGetCap(fd, DRM_CAP_SYNCOBJ_TIMELINE, &cap) == 0 && cap != 0;
+        };
+        g_pCompositor->m_drm.syncobjSupport = supported(g_pCompositor->m_drm.fd);
+        g_pCompositor->m_drmRenderNode.syncObjSupport = supported(g_pCompositor->m_drmRenderNode.fd);
+        if (PROTO::sync && !PROTO::sync->migrateRenderNodeForLab(g_pCompositor->m_drmRenderNode.fd))
+            throw std::runtime_error("explicit-sync state was not idle during descriptor replacement");
+    }
+
+    void restoreLeaseProtocols() {
+        for (const auto& impl : g_pCompositor->m_aqBackend->getImplementations()) {
+            if (impl->type() != Aquamarine::AQ_BACKEND_DRM) continue;
+            auto lease = makeShared<CDRMLeaseProtocol>(&wp_drm_lease_device_v1_interface, 1, "DRMLease", impl);
+            if (lease->good()) PROTO::lease.emplace(lease->getDeviceName(), lease);
+        }
+    }
+
+    void require(bool condition, const char* message) {
+        if (!condition) throw std::runtime_error(message);
+    }
+    void checkGL(const char* message) {
+        require(glGetError() == GL_NO_ERROR, message);
+    }
+    std::string deviceName(int fd) {
+        char* name = drmGetRenderDeviceNameFromFd(fd);
+        std::string result = name ? name : "unknown";
+        free(name);
+        return result;
+    }
+    constexpr GLenum parameters[] = {GL_TEXTURE_WRAP_S, GL_TEXTURE_WRAP_T, GL_TEXTURE_MAG_FILTER,
+        GL_TEXTURE_MIN_FILTER, GL_TEXTURE_SWIZZLE_R, GL_TEXTURE_SWIZZLE_G, GL_TEXTURE_SWIZZLE_B, GL_TEXTURE_SWIZZLE_A};
+
+    struct TextureCopy {
+        CGLTexture* original;
+        std::unique_ptr<CGLTexture> replacement;
+        GLint width = 0, height = 0, internal = GL_RGBA8;
+        bool floating = false, depth = false;
+        std::array<GLint, 8> params;
+        std::vector<unsigned char> bytes;
+        std::vector<float> floats;
+    };
+}
+
+void CMigration::track(CGLTexture* p) { textures.insert(p); }
+void CMigration::track(CGLFramebuffer* p) { framebuffers.insert(p); }
+void CMigration::track(CGLRenderbuffer* p) { renderbuffers.insert(p); }
+void CMigration::track(CShader* p) { shaders.insert(p); }
+void CMigration::untrack(CGLTexture* p) { textures.erase(p); }
+void CMigration::untrack(CGLFramebuffer* p) { framebuffers.erase(p); }
+void CMigration::untrack(CGLRenderbuffer* p) { renderbuffers.erase(p); }
+void CMigration::untrack(CShader* p) { shaders.erase(p); }
+
+std::string CMigration::command(const std::string& request) {
+    if (!getenv("HYPRLAND_MIGRATION_LAB") || std::string(getenv("HYPRLAND_MIGRATION_LAB")) != "1")
+        return "error: this experiment requires HYPRLAND_MIGRATION_LAB=1 at startup\n";
+    std::istringstream input(request);
+    std::string command, operation, path, extra;
+    input >> command >> operation >> path >> extra;
+    if (operation == "status" && path.empty()) {
+        g_pHyprOpenGL->makeEGLCurrent();
+        const auto* renderer = glGetString(GL_RENDERER);
+        return std::format("generation: {}\nrenderer: {}\nrender_node: {}\nbackend_node: {}\ntextures: {}\nlast_result: {}\nphysical_enabled: {}\ndrm_parked: {}\nvfio_ready: false (external process and kernel audit required)\n",
+            generation, renderer ? reinterpret_cast<const char*>(renderer) : "unknown", deviceName(g_pHyprOpenGL->m_drmFD),
+            deviceName(g_pCompositor->m_drm.fd), textures.size(), lastResult, physicalEnabled(), g_pCompositor->m_aqBackend->drmParkedForMigration());
+    }
+    if (operation == "can-release" && path.empty() && extra.empty()) {
+        if (busy) return "blocked: migration already in progress\n";
+        if (g_pCompositor->m_aqBackend->hasSession() && !physicalEnabled()) return "blocked: physical migration was not enabled at startup\n";
+        if (const auto blocker = clientBlocker(); !blocker.empty()) return "blocked: " + blocker + "\n";
+        return "CLIENTS_IDLE (not a global GPU or physical VFIO audit)\n";
+    }
+    if ((operation != "probe" && operation != "switch" && operation != "release" && operation != "prefer" && operation != "park" && operation != "resume") || path.empty() || !extra.empty())
+        return "error: usage: migration status/can-release | migration probe/switch/release/prefer /dev/dri/renderD…\n";
+    if (busy) return "error: migration already in progress\n";
+    busy = true;
+    try {
+        if (operation == "park" || operation == "resume") {
+            auto backend = g_pCompositor->m_aqBackend;
+            require(physicalEnabled() && backend->hasSession(), "park/resume requires the opt-in physical compositor");
+            const auto blocker = clientBlocker();
+            if (!blocker.empty()) throw std::runtime_error(blocker);
+            require(std::ranges::any_of(State::monitorState()->monitors(), [](const auto& mon) {
+                return mon->m_name == "MIGRATION-PARK" && mon->m_pixelSize.x > 0 && mon->m_output->getBackend()->type() == Aquamarine::AQ_BACKEND_HEADLESS;
+            }), "a ready MIGRATION-PARK headless output is required");
+            require(!g_pHyprRenderer->m_renderData.pMonitor && !g_pHyprRenderer->m_renderData.currentFB, "a render pass is active");
+            require(dlsym(RTLD_DEFAULT, "eglLabUnload") != nullptr, "the private EGL loader is required");
+            const auto resolved = std::filesystem::canonical(path);
+            require(resolved.parent_path() == "/dev/dri" && resolved.filename().string().starts_with("renderD"), "target must name a render node");
+            CFileDescriptor target{open(resolved.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW)};
+            require(target.isValid() && drmGetNodeTypeFromFd(target.get()) == DRM_NODE_RENDER, "target render node unavailable");
+            if (operation == "park") {
+                require(!backend->drmParkedForMigration(), "already parked");
+                require(!g_pXWayland || !g_pXWayland->enabled(), "disable Xwayland after closing its applications before parking");
+                // Validate the fallback renderer before disconnecting outputs.
+                { auto probe = makeUnique<CHyprOpenGLImpl>(target.get()); }
+                g_pHyprOpenGL->makeEGLCurrent();
+                if (!g_pHyprOpenGL->m_migrationFD.isValid()) {
+                    g_pHyprOpenGL->m_migrationFD = CFileDescriptor{fcntl(g_pHyprOpenGL->m_drmFD, F_DUPFD_CLOEXEC, 0)};
+                    require(g_pHyprOpenGL->m_migrationFD.isValid(), "cannot retain original render node during KMS teardown");
+                    g_pHyprOpenGL->m_drmFD = g_pHyprOpenGL->m_migrationFD.get();
+                }
+                PROTO::lease.clear(); // These otherwise retain shared DRM backend ownership.
+                backend->setMigrationRenderFormats(g_pHyprOpenGL->getDRMFormats());
+                const auto error = backend->parkDRMForMigration();
+                if (!error.empty()) {
+                    restoreLeaseProtocols();
+                    throw std::runtime_error(error);
+                }
+                updateProtocolNodes();
+                lastResult = run(path, true, true);
+                if (lastResult.starts_with("RELEASE_REBUILT")) lastResult = "PARK_PASS " + lastResult;
+            } else {
+                require(backend->drmParkedForMigration(), "physical backends are not parked");
+                lastResult = run(path, true, true);
+                if (lastResult.starts_with("RELEASE_REBUILT")) {
+                    const auto error = backend->resumeDRMForMigration();
+                    if (!error.empty()) throw std::runtime_error(error);
+                    updateProtocolNodes();
+                    restoreLeaseProtocols();
+                    g_pHyprOpenGL->makeEGLCurrent();
+                    lastResult = "RESUME_PASS " + lastResult;
+                }
+            }
+        } else if (operation == "prefer") {
+            require(!g_pCompositor->m_aqBackend->hasSession() && bool(PROTO::linuxDma), "preference test requires the nested laboratory");
+            const auto resolved = std::filesystem::canonical(path);
+            require(resolved.parent_path() == "/dev/dri" && resolved.filename().string().starts_with("renderD"), "target must name a DRM render node");
+            CFileDescriptor fd{open(resolved.c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW)};
+            require(fd.isValid() && drmGetNodeTypeFromFd(fd.get()) == DRM_NODE_RENDER, "invalid render node");
+            std::vector<SDRMFormat> targetFormats;
+            {
+                auto target = makeUnique<CHyprOpenGLImpl>(fd.get());
+                targetFormats = target->getDRMFormats();
+            }
+            g_pHyprOpenGL->makeEGLCurrent();
+            std::vector<SDRMFormat> common;
+            for (const auto& current : g_pHyprOpenGL->getDRMFormats()) {
+                SDRMFormat match{.drmFormat = current.drmFormat};
+                for (const auto& target : targetFormats) {
+                    if (target.drmFormat != current.drmFormat) continue;
+                    for (const auto mod : current.modifiers)
+                        if (std::ranges::find(target.modifiers, mod) != target.modifiers.end()) match.modifiers.push_back(mod);
+                }
+                if (!match.modifiers.empty()) common.push_back(std::move(match));
+            }
+            require(!common.empty(), "GPUs have no common import formats");
+            const auto count = PROTO::linuxDma->preferDeviceForLab(fd.get(), common);
+            lastResult = std::format("PREFERENCE_SENT device={} feedback_objects={} common_formats={} (renderer unchanged; client migration unproven)", path, count, common.size());
+        } else
+            lastResult = run(path, operation != "probe", operation == "release");
+    } catch (const std::exception& e) {
+        lastResult = std::string("error: ") + e.what();
+        g_pHyprOpenGL->makeEGLCurrent();
+    }
+    busy = false;
+    LOG(Log::WARN, "Migration laboratory: {}", lastResult);
+    return lastResult + "\n";
+}
+
+std::string CMigration::run(const std::string& path, bool commit, bool unload) {
+    // Only render nodes: never acquire DRM master, open a physical disk, or bind a driver.
+    const auto resolved = std::filesystem::canonical(path);
+    require(resolved.parent_path() == "/dev/dri" && resolved.filename().string().starts_with("renderD"), "target must name a DRM render node");
+    CFileDescriptor target{open(resolved.c_str(), O_RDWR | O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW)};
+    require(target.isValid() && drmGetNodeTypeFromFd(target.get()) == DRM_NODE_RENDER, "target must be an accessible DRM render node");
+    require(!g_pHyprRenderer->m_renderData.pMonitor && !g_pHyprRenderer->m_renderData.currentFB, "a render pass is active; retry between frames");
+    const bool replaceOutputs = getenv("HYPRLAND_MIGRATION_LAB_REALLOCATE") != nullptr;
+    if (replaceOutputs) {
+        require(!g_pCompositor->m_aqBackend->hasSession() || (physicalEnabled() && g_pCompositor->m_aqBackend->drmParkedForMigration()),
+            "physical KMS backends must be parked before output reallocation");
+        for (const auto& mon : State::monitorState()->monitors()) {
+            const auto type = mon->m_output->getBackend()->type();
+            require(type == Aquamarine::AQ_BACKEND_WAYLAND || type == Aquamarine::AQ_BACKEND_HEADLESS,
+                "output reallocation requires Wayland or headless outputs only");
+        }
+    }
+    auto unloadEGL = reinterpret_cast<EGLBoolean (*)()>(dlsym(RTLD_DEFAULT, "eglLabUnload"));
+    if (unload) {
+        require(replaceOutputs && unloadEGL, "release requires the private EGL loader and output reallocation");
+        require(!PROTO::sync || PROTO::sync->migrationIdle(), "explicit-sync clients prevent device release");
+        require(!PROTO::linuxDma || PROTO::linuxDma->migrationIdle(), "DMA-BUF clients must cooperate before device release");
+        require(!PROTO::mesaDRM || PROTO::mesaDRM->migrationIdle(), "legacy DRM clients prevent device release");
+    }
+
+    std::vector<TextureCopy> copies;
+    const auto originalFramebuffers = framebuffers;
+    const auto originalRenderbuffers = renderbuffers;
+    const auto originalShaders = shaders;
+    std::set<CShader*> activeShaders;
+    std::set<CGLFramebuffer*> activeFBs;
+    std::set<CGLFramebuffer*> importedFBs;
+    for (auto* rb : originalRenderbuffers)
+        if (rb->m_framebuffer) importedFBs.insert(static_cast<CGLFramebuffer*>(rb->m_framebuffer.get()));
+    for (auto* tex : textures) {
+        require(!tex->m_eglImage, "DMA-BUF client textures are not supported in this first prototype; use the SHM test client");
+        require(tex->m_target == GL_TEXTURE_2D, "3D/external textures are not supported in this first prototype");
+    }
+    for (auto* fb : originalFramebuffers)
+        require(!fb->m_fbAllocated || !fb->m_tempBuf || importedFBs.contains(fb), "untracked temporary framebuffer");
+    for (auto* fb : originalFramebuffers)
+        if (fb->m_fbAllocated && !importedFBs.contains(fb)) activeFBs.insert(fb);
+    for (auto* shader : originalShaders)
+        if (shader->m_program) {
+            require(!shader->m_migrationVert.empty(), "shader source unavailable; enable the experiment before starting Hyprland");
+            activeShaders.insert(shader);
+        }
+
+    g_pHyprOpenGL->makeEGLCurrent();
+    glFinish();
+    while (glGetError() != GL_NO_ERROR) {}
+    g_pHyprOpenGL->setActiveTexture(GL_TEXTURE0);
+    size_t snapshotBytes = 0;
+    GLuint scratch = 0;
+    glGenFramebuffers(1, &scratch);
+    try {
+        for (auto* tex : textures) {
+            if (!tex->m_texID) continue;
+            TextureCopy copy{.original = tex};
+            glBindTexture(GL_TEXTURE_2D, tex->m_texID);
+            glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &copy.width);
+            glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &copy.height);
+            glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_INTERNAL_FORMAT, &copy.internal);
+            for (size_t i = 0; i < std::size(parameters); ++i)
+                glGetTexParameteriv(GL_TEXTURE_2D, parameters[i], &copy.params[i]);
+            checkGL("reading texture metadata failed");
+            if (copy.width && copy.height) {
+                copy.depth = copy.internal == GL_DEPTH24_STENCIL8;
+                copy.floating = copy.internal == GL_RGBA16F || copy.internal == GL_RGBA32F;
+                require(copy.depth || copy.floating || copy.internal == GL_RGBA8 || copy.internal == GL_RGB8 ||
+                    copy.internal == GL_RGBA || copy.internal == GL_RGB || copy.internal == GL_BGRA_EXT,
+                    "unsupported texture storage format; original renderer kept");
+                const size_t n = size_t(copy.width) * size_t(copy.height) * 4;
+                snapshotBytes += n * (copy.floating ? sizeof(float) : 1);
+                require(snapshotBytes <= 256 * 1024 * 1024, "texture snapshots exceed the 256 MiB laboratory limit");
+                if (!copy.depth) {
+                    g_pHyprOpenGL->bindFramebuffer(GL_FRAMEBUFFER, scratch);
+                    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex->m_texID, 0);
+                    require(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE, "texture cannot be read back; original renderer kept");
+                    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+                    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
