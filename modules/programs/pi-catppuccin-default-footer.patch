+
+const catppuccin = {
+	mauve: "#c6a0f6",
+	blue: "#8aadf4",
+	lavender: "#b7bdf8",
+	green: "#a6da95",
+	peach: "#f5a97f",
+	overlay0: "#6e738d",
+};
+
+function catppuccinFg(hex: string, text: string): string {
+	const value = hex.replace("#", "");
+	const red = Number.parseInt(value.slice(0, 2), 16);
+	const green = Number.parseInt(value.slice(2, 4), 16);
+	const blue = Number.parseInt(value.slice(4, 6), 16);
+	return `\x1b[38;2;${red};${green};${blue}m${text}\x1b[39m`;
+}
+
+function formatCatppuccinCount(value: number): string {
+	if (value < 1000) return `${value}`;
+	if (value < 1_000_000) return `${(value / 1000).toFixed(1)}k`;
+	return `${(value / 1_000_000).toFixed(1)}m`;
+}
+
+function formatCatppuccinModelName(model: string): string {
+	return (model.split("/").pop() ?? model).replace(/-\d{8}$/, "");
+}
+
+function formatCatppuccinFooterLine(width: number, left: string, right: string): string {
+	const padWidth = Math.max(1, width - visibleWidth(left) - visibleWidth(right));
+	return truncateToWidth(`${left}${" ".repeat(padWidth)}${right}`, width, "");
+}
+
+/** Compact Catppuccin footer used throughout the interactive session. */
+export class CatppuccinFooterComponent extends FooterComponent {
+	override render(width: number): string[] {
+		if (width <= 0) return [""];
+
+		let input = 0;
+		let output = 0;
+		let cost = 0;
+		for (const entry of this.session.sessionManager.getBranch()) {
+			if (entry.type !== "message" || entry.message.role !== "assistant") continue;
+			input += entry.message.usage.input ?? 0;
+			output += entry.message.usage.output ?? 0;
+			cost += entry.message.usage.cost?.total ?? 0;
+		}
+
+		const branch = this.footerData.getGitBranch();
+		const model = formatCatppuccinModelName(this.session.state.model?.id ?? "no model");
+		const branchName = branch ?? "no git";
+		const compactStats = [
+			catppuccinFg(catppuccin.blue, `↑${formatCatppuccinCount(input)}`),
+			catppuccinFg(catppuccin.lavender, `↓${formatCatppuccinCount(output)}`),
+			catppuccinFg(catppuccin.peach, `$${cost.toFixed(3)}`),
+		].join(" ");
+		const fullLeft = [
+			catppuccinFg(catppuccin.mauve, "◆"),
+			catppuccinFg(catppuccin.blue, model),
+			catppuccinFg(catppuccin.overlay0, "•"),
+			catppuccinFg(catppuccin.green, branch ? `git ${branchName}` : branchName),
+		].join(" ");
+		const fullRight = [
+			catppuccinFg(catppuccin.blue, `in ${formatCatppuccinCount(input)}`),
+			catppuccinFg(catppuccin.lavender, `out ${formatCatppuccinCount(output)}`),
+			catppuccinFg(catppuccin.peach, `cost $${cost.toFixed(3)}`),
+		].join("  ");
+
+		if (visibleWidth(fullLeft) + 1 + visibleWidth(fullRight) <= width) {
+			return [formatCatppuccinFooterLine(width, fullLeft, fullRight)];
+		}
+
+		const compactLeft = [
+			catppuccinFg(catppuccin.mauve, "◆"),
+			catppuccinFg(catppuccin.blue, model),
+			catppuccinFg(catppuccin.overlay0, "•"),
+			catppuccinFg(catppuccin.green, branchName),
+		].join(" ");
+		if (visibleWidth(compactLeft) + 1 + visibleWidth(compactStats) <= width) {
+			return [formatCatppuccinFooterLine(width, compactLeft, compactStats)];
+		}
+
+		return [truncateToWidth([catppuccinFg(catppuccin.mauve, "◆"), catppuccinFg(catppuccin.blue, model), compactStats].join(" "), width, "")];
+	}
+}
