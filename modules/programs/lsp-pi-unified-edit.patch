+export function createTouchedBatchState() {
+  const touchedFiles = new Map<string, boolean>();
+
+  function add(filePath: string, includeWarnings: boolean): void {
+    touchedFiles.set(filePath, (touchedFiles.get(filePath) ?? false) || includeWarnings);
+  }
+
+  async function flush(
+    isSafe: () => boolean,
+    collect: (filePath: string, includeWarnings: boolean) => Promise<string | undefined>,
+    send: (content: string) => void,
+  ): Promise<boolean> {
+    if (touchedFiles.size === 0) return true;
+    if (!isSafe()) return false;
+    const files = Array.from(touchedFiles.entries());
+    const outputs: string[] = [];
+    for (const [filePath, includeWarnings] of files) {
+      if (!isSafe()) return false;
+      const output = await collect(filePath, includeWarnings);
+      if (!isSafe()) return false;
+      if (output) outputs.push(output);
+    }
+    if (!isSafe()) return false;
+    if (outputs.length) send(outputs.join("\n"));
+    for (const [filePath, includeWarnings] of files) {
+      if (touchedFiles.get(filePath) === includeWarnings) touchedFiles.delete(filePath);
+    }
+    return true;
+  }
+
+  return { touchedFiles, add, flush };
+}
