+import { createHash } from "node:crypto";
+import { lstat, readFile, realpath } from "node:fs/promises";
+import * as path from "node:path";
+import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
+
+type Snapshot = { digest: string; dev: number; ino: number };
+type SnapshotWithBytes = Snapshot & { bytes: Buffer };
+type ManifestFile = { absolutePath?: unknown; kind?: unknown };
+type Manifest = { version?: unknown; files?: unknown };
+type Reservation = { paths: string[] };
+
+const COMPAT = Symbol.for("pi-unified-edit:lsp-guard-compat");
+(globalThis as Record<symbol, unknown>)[COMPAT] = 1;
+
+function within(cwd: string, candidate: string): boolean {
+  const rel = path.relative(cwd, candidate);
+  return rel === "" || (!rel.startsWith(`..${path.sep}`) && rel !== ".." && !path.isAbsolute(rel));
+}
+
+async function canonicalExisting(cwd: string, rawPath: string): Promise<string> {
+  const root = await realpath(cwd);
+  const resolved = path.resolve(root, rawPath.replace(/^@/, ""));
+  if (!within(root, resolved)) throw new Error(`path escapes workspace: ${rawPath}`);
+  const canonical = await realpath(resolved);
+  if (!within(root, canonical)) throw new Error(`path escapes workspace through a symlink: ${rawPath}`);
+  const info = await lstat(resolved);
+  if (info.isSymbolicLink() || !info.isFile()) throw new Error(`not a regular file: ${rawPath}`);
+  return canonical;
+}
+
+async function canonicalTarget(cwd: string, rawPath: string): Promise<{ path: string; exists: boolean }> {
+  try {
+    return { path: await canonicalExisting(cwd, rawPath), exists: true };
+  } catch (error: any) {
+    if (error?.code !== "ENOENT") throw error;
+    const root = await realpath(cwd);
+    const resolved = path.resolve(root, rawPath.replace(/^@/, ""));
+    if (!within(root, resolved)) throw new Error(`path escapes workspace: ${rawPath}`);
+    let cursor = path.dirname(resolved);
+    while (true) {
+      try {
+        const parent = await realpath(cursor);
+        if (!within(root, parent)) throw new Error(`path escapes workspace through a symlink: ${rawPath}`);
+        break;
+      } catch (parentError: any) {
+        if (parentError?.code !== "ENOENT") throw parentError;
+        const next = path.dirname(cursor);
+        if (next === cursor) throw parentError;
+        cursor = next;
+      }
+    }
+    return { path: resolved, exists: false };
+  }
+}
+
+async function snapshotWithBytes(filePath: string): Promise<SnapshotWithBytes> {
+  const before = await lstat(filePath);
+  if (before.isSymbolicLink() || !before.isFile()) throw new Error(`not a regular file: ${filePath}`);
+  const bytes = await readFile(filePath);
+  const after = await lstat(filePath);
+  if (after.isSymbolicLink() || !after.isFile() || before.dev !== after.dev || before.ino !== after.ino ||
+      before.size !== after.size || before.mtimeMs !== after.mtimeMs || before.ctimeMs !== after.ctimeMs) {
+    throw new Error(`file changed while snapshotting: ${filePath}`);
+  }
+  return {
+    digest: createHash("sha256").update(bytes).digest("hex"),
+    dev: after.dev,
+    ino: after.ino,
+    bytes,
+  };
+}
+
+async function snapshot(filePath: string): Promise<Snapshot> {
+  const { digest, dev, ino } = await snapshotWithBytes(filePath);
+  return { digest, dev, ino };
+}
+
+function same(a: Snapshot, b: Snapshot): boolean {
+  return a.digest === b.digest && a.dev === b.dev && a.ino === b.ino;
+}
+
+function manifest(input: unknown): Manifest | undefined {
+  if (!input || typeof input !== "object") return undefined;
+  const value = (input as any).__piUnifiedEdit;
+  return value?.version === 1 && Array.isArray(value.files) ? value : undefined;
+}
+
+function manifestFiles(value: Manifest): ManifestFile[] {
+  return value.files as ManifestFile[];
+}
+
+export function createReadGuardState() {
+  const authorized = new Map<string, Snapshot>();
+  const reservations = new Map<string, string>();
+  const byCall = new Map<string, Reservation>();
+
+  async function authorizeRead(event: any, cwd: string): Promise<void> {
+    if (event.toolName !== "read" || event.isError) return;
+    if (event.input?.offset !== undefined || event.input?.limit !== undefined) return;
+    if (event.details?.truncation?.truncated) return;
+    if (typeof event.input?.path !== "string" || !Array.isArray(event.content)) return;
+    const textBlocks = event.content.filter((item: any) => item?.type === "text" && typeof item.text === "string");
+    if (textBlocks.length !== 1 || event.content.length !== 1) return;
+    try {
+      const filePath = await canonicalExisting(cwd, event.input.path);
+      const current = await snapshotWithBytes(filePath);
+      if (current.bytes.toString("utf8") !== textBlocks[0].text) return;
+      authorized.set(filePath, { digest: current.digest, dev: current.dev, ino: current.ino });
+    } catch {
+      // Failed, non-text, incoherent, or non-regular reads never grant authorization.
+    }
+  }
+
+  function release(toolCallId: string): void {
+    const reservation = byCall.get(toolCallId);
+    if (!reservation) return;
+    for (const filePath of reservation.paths) {
+      if (reservations.get(filePath) === toolCallId) reservations.delete(filePath);
+    }
+    byCall.delete(toolCallId);
+  }
+
+  async function reserve(event: any, cwd: string): Promise<{ block: true; reason: string } | undefined> {
+    const targets: Array<{ rawPath: string; requireRead: boolean }> = [];
+    const value = manifest(event.input);
+    if (event.toolName === "edit" && value) {
+      for (const file of manifestFiles(value)) {
+        if (typeof file.absolutePath !== "string") return { block: true, reason: "Unified Edit guard manifest contains an invalid path." };
+        targets.push({ rawPath: file.absolutePath, requireRead: file.kind !== "add" });
+      }
+    } else if (event.toolName === "write" && typeof event.input?.path === "string") {
+      targets.push({ rawPath: event.input.path, requireRead: true });
+    } else {
+      return undefined;
+    }
+
+    const checked: Array<{ path: string; exists: boolean; requireRead: boolean }> = [];
+    try {
+      for (const target of targets) {
+        const resolved = await canonicalTarget(cwd, target.rawPath);
+        checked.push({ ...resolved, requireRead: target.requireRead });
+      }
+    } catch (error: any) {
+      return { block: true, reason: `Read guard rejected mutation: ${error?.message ?? String(error)}` };
+    }
+
+    const unique = [...new Map(checked.map((target) => [target.path, target])).values()];
+    for (const target of unique) {
+      const owner = reservations.get(target.path);
+      if (owner && owner !== event.toolCallId) {
+        return { block: true, reason: `Read guard rejected overlapping mutation: ${target.path}` };
+      }
+      if (!target.exists) continue;
+      if (!target.requireRead) {
+        return { block: true, reason: `Read guard expected a new file but target exists: ${target.path}` };
+      }
+      const prior = authorized.get(target.path);
+      if (!prior) return { block: true, reason: `Read guard requires a full current read before editing: ${target.path}` };
+      const current = await snapshot(target.path);
+      if (!same(prior, current)) {
+        return { block: true, reason: `Read guard found stale contents or changed file identity: ${target.path}` };
+      }
+    }
+
+    const paths = unique.map((target) => target.path);
+    for (const filePath of paths) reservations.set(filePath, event.toolCallId);
+    byCall.set(event.toolCallId, { paths });
+    return undefined;
+  }
+
+  async function finish(event: any, cwd: string): Promise<void> {
+    const reservation = byCall.get(event.toolCallId);
+    try {
+      if (!reservation || event.isError) return;
+      const value = manifest(event.input);
+      if (event.toolName === "edit" && value && Array.isArray(event.details?.files)) {
+        for (const file of event.details.files as any[]) {
+          if (typeof file?.absolutePath !== "string") continue;
+          if (file.kind === "delete") {
+            authorized.delete(file.absolutePath);
+            continue;
+          }
+          const canonical = await canonicalExisting(cwd, file.absolutePath);
+          authorized.set(canonical, await snapshot(canonical));
+        }
+      } else if (event.toolName === "write" && typeof event.input?.path === "string") {
+        const canonical = await canonicalExisting(cwd, event.input.path);
+        authorized.set(canonical, await snapshot(canonical));
+      }
+    } finally {
+      release(event.toolCallId);
+    }
+  }
+
+  function clear(): void {
+    authorized.clear();
+    reservations.clear();
+    byCall.clear();
+  }
+
+  return { authorizeRead, reserve, finish, release, clear, authorized, reservations };
+}
+
+export default function readGuard(pi: ExtensionAPI): void {
+  const state = createReadGuardState();
+  pi.on("tool_call", (event, ctx) => state.reserve(event, ctx.cwd));
+  pi.on("tool_result", async (event, ctx) => {
+    await state.authorizeRead(event, ctx.cwd);
+    await state.finish(event, ctx.cwd);
+  });
+  pi.on("turn_end", () => {
+    // Every tool in the batch has settled by turn_end. Release any reservation
+    // left behind by a later extension blocking execution or an exceptional
+    // path that did not produce the usual result middleware callback.
+    for (const toolCallId of new Set(state.reservations.values())) state.release(toolCallId);
+  });
+  pi.on("session_shutdown", () => state.clear());
+}
+
+export const __test = { createReadGuardState, canonicalExisting, canonicalTarget, snapshot };
