new file mode 100644
index 0000000..b6f9568
--- /dev/null
+++ b/crates/platform-linux/src/wayland/hyprland_ipc.rs
@@ -0,0 +1,307 @@
+//! Best-effort Hyprland compositor metadata.
+//!
+//! The Wayland foreign-toplevel protocols expose titles and app ids, but not
+//! process ids or geometry. Hyprland's JSON IPC supplies those missing fields
+//! together with a compositor-stable window address.
+
+use std::collections::HashSet;
+use std::process::{Command, Stdio};
+
+use serde::Deserialize;
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct Workspace {
+    id: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct Client {
+    address: String,
+    #[serde(default)]
+    mapped: bool,
+    #[serde(default)]
+    hidden: bool,
+    #[serde(default)]
+    at: [i32; 2],
+    #[serde(default)]
+    size: [i32; 2],
+    #[serde(default)]
+    workspace: Workspace,
+    #[serde(default)]
+    class: String,
+    #[serde(default)]
+    title: String,
+    pid: Option<u32>,
+    #[serde(default)]
+    pinned: bool,
+    #[serde(default)]
+    fullscreen: i32,
+    #[serde(default, rename = "focusHistoryID")]
+    focus_history_id: i32,
+}
+
+#[derive(Clone, Debug, Default, Deserialize)]
+struct Monitor {
+    #[serde(default, rename = "activeWorkspace")]
+    active_workspace: Workspace,
+    #[serde(default, rename = "specialWorkspace")]
+    special_workspace: Workspace,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Window {
+    pub id: u64,
+    pub pid: u32,
+    pub title: String,
+    pub app_id: String,
+    pub x: i32,
+    pub y: i32,
+    pub width: u32,
+    pub height: u32,
+    pub content_x: i32,
+    pub content_y: i32,
+    pub focused: bool,
+    pub visible: bool,
+    pub fullscreen: bool,
+}
+
+fn hyprctl_json(object: &str) -> Option<Vec<u8>> {
+    if std::env::var_os("HYPRLAND_INSTANCE_SIGNATURE").is_none() {
+        return None;
+    }
+    let output = Command::new("hyprctl")
+        .args(["-j", object])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    output.status.success().then_some(output.stdout)
+}
+
+fn parse_address(address: &str) -> Option<u64> {
+    u64::from_str_radix(address.trim().trim_start_matches("0x"), 16).ok()
+}
+
+fn parse_clients(clients: &[u8], monitors: &[u8]) -> Option<Vec<Window>> {
+    let clients: Vec<Client> = serde_json::from_slice(clients).ok()?;
+    let monitors: Vec<Monitor> = serde_json::from_slice(monitors).ok()?;
+    let active_workspaces = monitors
+        .into_iter()
+        .flat_map(|monitor| [monitor.active_workspace.id, monitor.special_workspace.id])
+        .filter(|id| *id != 0)
+        .collect::<HashSet<_>>();
+
+    Some(
+        clients
+            .into_iter()
+            .filter_map(|client| {
+                let id = parse_address(&client.address)?;
+                let pid = client.pid?;
+                let width = client.size[0].max(0) as u32;
+                let height = client.size[1].max(0) as u32;
+                let visible = client.mapped
+                    && !client.hidden
+                    && (client.pinned || active_workspaces.contains(&client.workspace.id))
+                    && width > 0
+                    && height > 0;
+                Some(Window {
+                    id,
+                    pid,
+                    title: client.title,
+                    app_id: client.class,
+                    x: client.at[0],
+                    y: client.at[1],
+                    width,
+                    height,
+                    content_x: 0,
+                    content_y: 0,
+                    focused: client.focus_history_id == 0,
+                    visible,
+                    fullscreen: client.fullscreen != 0,
+                })
+            })
+            .collect(),
+    )
+}
+
+pub fn list_windows() -> Option<Vec<Window>> {
+    let clients = hyprctl_json("clients")?;
+    let monitors = hyprctl_json("monitors")?;
+    parse_clients(&clients, &monitors)
+}
+
+pub fn window_for_id(id: u64) -> Option<Window> {
+    list_windows()?.into_iter().find(|window| window.id == id)
+}
+
+pub fn window_for_pid(pid: u32) -> Option<Window> {
+    list_windows()?
+        .into_iter()
+        .filter(|window| window.pid == pid && window.width > 0 && window.height > 0)
+        .max_by_key(|window| {
+            (
+                window.focused,
+                window.visible,
+                u64::from(window.width) * u64::from(window.height),
+            )
+        })
+}
+
+pub fn window_for_title(title: &str) -> Option<Window> {
+    list_windows()?
+        .into_iter()
+        .filter(|window| {
+            window.width > 0
+                && window.height > 0
+                && (window.title == title
+                    || (!window.title.is_empty() && title.starts_with(&window.title))
+                    || (!title.is_empty() && window.title.starts_with(title)))
+        })
+        .max_by_key(|window| (window.focused, window.visible))
+}
+
+pub fn window_for_app_id(app_id: &str) -> Option<Window> {
+    if app_id.is_empty() {
+        return None;
+    }
+    list_windows()?
+        .into_iter()
+        .filter(|window| window.width > 0 && window.height > 0 && window.app_id == app_id)
+        .max_by_key(|window| (window.focused, window.visible))
+}
+
+fn focus_window(id: u64) -> bool {
+    let lua_dispatcher = format!(r#"hl.dsp.focus({{ window = "address:0x{id:x}" }})"#);
+    if Command::new("hyprctl")
+        .args(["dispatch", lua_dispatcher.as_str()])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status()
+        .is_ok_and(|status| status.success())
+    {
+        return true;
+    }
+
+    // Hyprland before 0.55 used the legacy dispatcher-and-argument form.
+    let selector = format!("address:0x{id:x}");
+    Command::new("hyprctl")
+        .args(["dispatch", "focuswindow", selector.as_str()])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .status()
+        .is_ok_and(|status| status.success())
+}
+
+fn wait_for_window_focus(id: u64, timeout: std::time::Duration) -> bool {
+    let deadline = std::time::Instant::now() + timeout;
+    loop {
+        if window_for_id(id).is_some_and(|window| window.focused) {
+            return true;
+        }
+        if std::time::Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
+
+pub fn with_focused_window<T>(
+    id: u64,
+    body: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    let prior = list_windows()
+        .ok_or_else(|| anyhow::anyhow!("Hyprland IPC window list is unavailable"))?
+        .into_iter()
+        .find(|window| window.focused)
+        .map(|window| window.id);
+    if !focus_window(id) {
+        anyhow::bail!("Hyprland refused to focus exact window 0x{id:x}");
+    }
+    if !wait_for_window_focus(id, std::time::Duration::from_millis(500)) {
+        anyhow::bail!("Hyprland did not confirm focus on exact window 0x{id:x}");
+    }
+    let result = body();
+    let restore = prior
+        .filter(|prior| *prior != id)
+        .map(|prior| {
+            if !focus_window(prior) {
+                anyhow::bail!("Hyprland could not restore prior window 0x{prior:x}");
+            }
+            if !wait_for_window_focus(prior, std::time::Duration::from_millis(500)) {
+                anyhow::bail!("Hyprland did not confirm restored window 0x{prior:x}");
+            }
+            Ok(())
+        })
+        .transpose();
+    match (result, restore) {
+        (Ok(value), Ok(_)) => Ok(value),
+        (Err(error), Ok(_)) => Err(error),
+        (Ok(_), Err(error)) => Err(error),
+        (Err(error), Err(restore)) => Err(error.context(format!(
+            "the prior Hyprland focus also could not be restored: {restore}"
+        ))),
+    }
+}
+
+pub fn window_origin_for_pid(pid: u32) -> Option<(i32, i32)> {
+    window_for_pid(pid).map(|window| (window.x, window.y))
+}
+
+pub fn window_content_offset_for_pid(pid: u32) -> Option<(i32, i32)> {
+    window_for_pid(pid).map(|window| (window.content_x, window.content_y))
+}
+
+pub fn window_origin_for_title(title: &str) -> Option<(i32, i32)> {
+    window_for_title(title).map(|window| (window.x, window.y))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_geometry_identity_and_active_workspace_visibility() {
+        let clients = br#"[{
+          "address": "0x5b6e670523d0",
+          "mapped": true,
+          "hidden": false,
+          "at": [92, 32],
+          "size": [2436, 1376],
+          "workspace": {"id": 1, "name": "1"},
+          "class": "t3code",
+          "title": "T3 Code (Alpha)",
+          "pid": 18318,
+          "pinned": false,
+          "fullscreen": 1,
+          "focusHistoryID": 0
+        }, {
+          "address": "0xabc",
+          "mapped": true,
+          "hidden": false,
+          "at": [20, 30],
+          "size": [800, 600],
+          "workspace": {"id": 2, "name": "2"},
+          "class": "off-workspace",
+          "title": "Hidden by workspace",
+          "pid": 99,
+          "focusHistoryID": 1
+        }]"#;
+        let monitors = br#"[{
+          "activeWorkspace": {"id": 1, "name": "1"},
+          "specialWorkspace": {"id": 0, "name": ""}
+        }]"#;
+
+        let windows = parse_clients(clients, monitors).expect("valid Hyprland JSON");
+        assert_eq!(windows.len(), 2);
+        assert_eq!(windows[0].id, 0x5b6e670523d0);
+        assert_eq!(windows[0].pid, 18318);
+        assert_eq!((windows[0].x, windows[0].y), (92, 32));
+        assert_eq!((windows[0].width, windows[0].height), (2436, 1376));
+        assert!(windows[0].visible);
+        assert!(windows[0].focused);
+        assert!(windows[0].fullscreen);
+        assert!(!windows[1].visible);
+    }
+}
