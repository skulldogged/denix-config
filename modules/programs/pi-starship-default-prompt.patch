+/** Match pi-starship before extensions are loaded or rebound between sessions. */
+class StarshipDefaultEditor extends CustomEditor {
+	override render(width: number): string[] {
+		const prompt = theme.bold(theme.fg("success", "❯")) + " ";
+		const promptWidth = visibleWidth(prompt);
+		const innerWidth = Math.max(10, width - promptWidth);
+		const originalBorder = this.borderColor;
+		let raw: string[];
+
+		try {
+			this.borderColor = () => "";
+			raw = super.render(innerWidth);
+		} finally {
+			this.borderColor = originalBorder;
+		}
+
+		const lines = raw.filter((line) => line !== "");
+		if (lines.length === 0) {
+			return [prompt];
+		}
+
+		const indent = " ".repeat(promptWidth);
+		return [prompt + lines[0], ...lines.slice(1).map((line) => indent + line)];
+	}
+}
+
+/** pi-starship's information widget supersedes Pi's built-in footer. */
