@@ -0,0 +1,33 @@
+#pragma once
+
+#include <qhash.h>
+#include <qstring.h>
+#include <qvariant.h>
+
+namespace qs::hyprland::ipc {
+
+// New Hyprland IPC uses workspace selectors instead of numeric IDs. Keep
+// numbered workspaces numeric and allocate stable negative IDs for named
+// and special workspaces, shared by JSON snapshots and socket events.
+inline qint32 workspaceId(const QString& selector) {
+    bool numeric = false;
+    auto id = selector.toInt(&numeric);
+    if (numeric) return id;
+    if (selector.isEmpty()) return -1;
+
+    static QHash<QString, qint32> ids;
+    auto it = ids.constFind(selector);
+    if (it != ids.cend()) return it.value();
+    auto next = -1000000 - static_cast<qint32>(ids.size());
+    ids.insert(selector, next);
+    return next;
+}
+
+inline qint32 workspaceId(const QVariantMap& object) {
+    if (object.contains("id")) return object.value("id").toInt();
+    auto selector = object.value("address").toString();
+    if (object.value("type").toString() == "named") selector.prepend("name:");
+    return workspaceId(selector);
+}
+
+} // namespace qs::hyprland::ipc
