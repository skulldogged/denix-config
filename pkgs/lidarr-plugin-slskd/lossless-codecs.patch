+using NzbDrone.Core.Parser;
+using NzbDrone.Plugin.Slskd.Helpers;
+using NzbDrone.Plugin.Slskd.Models;
+
+static string Classify(
+    string extension,
+    int? bitDepth = null,
+    int? sampleRate = null,
+    string folder = "Album",
+    int? secondBitDepth = null)
+{
+    var files = new List<SlskdFile>
+    {
+        new()
+        {
+            FileName = $"share\\Artist\\{folder}\\01 Song.{extension}",
+            Extension = extension,
+            BitDepth = bitDepth,
+            SampleRate = sampleRate,
+            Size = 10_000_000,
+        },
+    };
+
+    if (secondBitDepth.HasValue)
+    {
+        files.Add(new SlskdFile
+        {
+            FileName = $"share\\Artist\\{folder}\\02 Song.{extension}",
+            Extension = extension,
+            BitDepth = secondBitDepth,
+            SampleRate = sampleRate,
+            Size = 10_000_000,
+        });
+    }
+
+    var audioFiles = files.FilterValidAudioFiles();
+    if (audioFiles.Count != files.Count)
+    {
+        return "FILTERED";
+    }
+
+    var title = FileProcessingUtils.BuildTitle(audioFiles);
+    return QualityParser.ParseQuality(title, null, 0).Quality.Name;
+}
+
+var cases = new[]
+{
+    (Extension: "flac", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album", SecondBitDepth: (int?)null, Expected: "FLAC"),
+    (Extension: "flac", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)null, Expected: "FLAC 24bit"),
+    (Extension: "alac", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album", SecondBitDepth: (int?)null, Expected: "ALAC"),
+    (Extension: "alac", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)null, Expected: "ALAC 24bit"),
+    (Extension: "m4a", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album [ALAC]", SecondBitDepth: (int?)null, Expected: "ALAC"),
+    (Extension: "m4a", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album\\ALAC", SecondBitDepth: (int?)null, Expected: "ALAC 24bit"),
+    (Extension: "ape", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album", SecondBitDepth: (int?)null, Expected: "APE"),
+    (Extension: "wv", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album", SecondBitDepth: (int?)null, Expected: "WavPack"),
+    (Extension: "wv", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)null, Expected: "WavPack"),
+    (Extension: "WV", BitDepth: (int?)16, SampleRate: (int?)44100, Folder: "Album", SecondBitDepth: (int?)null, Expected: "WavPack"),
+    (Extension: "m4a", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)null, Expected: "AAC-VBR"),
+    (Extension: "flac", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)16, Expected: "FLAC"),
+    (Extension: "alac", BitDepth: (int?)24, SampleRate: (int?)96000, Folder: "Album", SecondBitDepth: (int?)16, Expected: "ALAC"),
+};
+
+var failures = 0;
+foreach (var test in cases)
+{
+    var actual = Classify(test.Extension, test.BitDepth, test.SampleRate, test.Folder, test.SecondBitDepth);
+    var verdict = actual == test.Expected ? "PASS" : "FAIL";
+    Console.WriteLine($"{verdict} .{test.Extension} {test.BitDepth ?? 0}bit => {actual} (expected {test.Expected})");
+    failures += actual == test.Expected ? 0 : 1;
+}
+
+return failures == 0 ? 0 : 1;
