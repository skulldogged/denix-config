[Unit]
Description=Build and deploy the personal T3 Code Pi release channel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/denix-config/tools/t3code-channel/update.sh
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
